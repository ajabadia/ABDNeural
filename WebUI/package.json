{
  "name": "neuronik-webui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "NEURONiK WebUI — interfaz definitiva (JS vainilla sobre WebView2, sin framework) del plugin NEURONiK.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:visual": "playwright test e2e/visual.spec.js",
    "test:visual:update": "playwright test e2e/visual.spec.js --update-snapshots",
    "sync:wasm": "node scripts/sync-wasm.mjs"
  },
  "dependencies": {
    "@abdsynths/midi-keyb": "workspace:*",
    "@abdsynths/shared": "workspace:*"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "jsdom": "^24.0.0",
    "vite": "^5.4.21",
    "vitest": "^1.6.0"
  }
}
