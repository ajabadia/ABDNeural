#!/bin/sh
# pre-commit: el lanzador del hook que vigila los scripts (.bat, .ps1 y .sh).
#
# POR QUE ESTE FICHERO ES SH Y NO PYTHON
#
# MEDIDO el 2026-10-03 en git for Windows: un hook con `#!/usr/bin/env python3`
# no arranca. Da "Python was not found; run without arguments to install from
# the Microsoft Store", el commit sale con codigo 1, y el mensaje no dice NADA
# de los .bat: parece que el hook se ha puesto en contra del commit entero, y lo
# unico que se ve es un fallo de Python.
# Aqui no hay python3, hay python.
#
# Y al reves en el otro lado: en los runners de ubuntu que usa el CI hay
# python3 y no python. Con un shebang fijo, uno de los dos lados no arranca, y
# del lado que no arranca el hook BLOQUEA el commit, que es peor que no tener
# hook: no es que no avise, es que no deja trabajar.
#
# Por eso este sh busca el que exista. sh lo entiende git for Windows de serie,
# porque los hooks de ejemplo que trae son sh.
#
# La logica vive al lado, en vigilar_scripts.py. Repartido asi, cambiar lo que se
# vigila no obliga a tocar el lanzador, que es la parte que hay que revisar con
# mas cuidado cuando algo se rompe en un runner.
#
# Sin `set -e` a proposito: el bucle de abajo tiene que poder seguir cuando uno de
# los tres interpretes no esta, y con `set -e` "no existe" aborta el script entero.

AQUI=$(dirname "$0")

for INTERPRETE in python python3 py; do
    if command -v "$INTERPRETE" >/dev/null 2>&1; then
        exec "$INTERPRETE" "$AQUI/vigilar_scripts.py" "$@"
    fi
done

# Ninguno de los tres. Se avisa y se deja pasar: bloquear todos los commits
# porque falta un interprete es peor que dejar entrar un .bat con LF, que es lo
# que este hook existe para cazar y se caza en el proximo commit.
echo "pre-commit: no hay python, python3 ni py en el PATH; los scripts NO se han" >&2
echo "            vigilado en este commit. Sin esto, un .bat o un .sh con LF pasa." >&2
exit 0
